<Window x:Class="Isla.IslaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Isla"
        Width="520" Height="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True">

  <Grid x:Name="Root" Background="Transparent">

    <!-- La isla: pegada al borde superior, esquinas inferiores redondeadas.
         Su tamano se anima al pasar el raton por encima. -->
    <Border x:Name="Isla"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Width="248" Height="34"
            CornerRadius="0,0,21,21"
            Background="{StaticResource Glass}"
            BorderBrush="#22FFFFFF"
            BorderThickness="1,0,1,1"
            Cursor="Hand"
            AllowDrop="True"
            MouseEnter="Isla_MouseEnter"
            MouseLeave="Isla_MouseLeave"
            DragEnter="Isla_DragEnter"
            DragOver="Isla_DragOver"
            DragLeave="Isla_DragLeave"
            Drop="Isla_Drop">

      <Border.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270"
                          Opacity="0.5" Color="#FF000000" />
      </Border.Effect>

      <!-- Deslizamiento al asomarse y al esconderse. -->
      <Border.RenderTransform>
        <TranslateTransform x:Name="IslaShift" Y="0" />
      </Border.RenderTransform>

      <Grid>

        <!-- linea de luz en el borde superior -->
        <Border Height="1" VerticalAlignment="Top" Margin="14,0"
                Background="{StaticResource GlassInnerEdge}" />

        <!-- ================================================ estado compacto
             La pildora recogida muestra la actividad en curso (copiar, mover,
             musica). La hora queda solo como ultimo recurso, discreta. -->
        <Grid x:Name="Compact" VerticalAlignment="Center" Margin="14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="CompactIcon" Grid.Column="0" Text="&#xE823;"
                     FontFamily="{StaticResource IconFont}" FontSize="12"
                     Foreground="{StaticResource Accent}"
                     VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock x:Name="CompactText" Grid.Column="1" Text="--:--"
                     FontSize="12.5" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
          <Border x:Name="CompactDot" Grid.Column="2" Width="6" Height="6"
                  CornerRadius="3" Background="{StaticResource Accent}"
                  Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0" />
        </Grid>

        <!-- ================================================ estado expandido -->
        <Grid x:Name="Dock" Opacity="0" IsHitTestVisible="False"
              Margin="20,14,20,16"
              VerticalAlignment="Top">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- ======================================== musica + reloj -->
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" VerticalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border x:Name="ArtworkFrame" Grid.Column="0"
                      Width="56" Height="56" CornerRadius="13"
                      Background="#1FFFFFFF" ClipToBounds="True">
                <Grid>
                  <TextBlock x:Name="ArtworkPlaceholder" Text="&#xE8D6;"
                             FontFamily="{StaticResource IconFont}" FontSize="18"
                             Foreground="{StaticResource TextMuted}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image x:Name="Artwork" Stretch="UniformToFill" />
                </Grid>
              </Border>

              <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                <TextBlock x:Name="TrackTitle" Text="Sin reproduccion"
                           FontSize="14" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" MaxWidth="230"
                           HorizontalAlignment="Left" />
                <TextBlock x:Name="TrackArtist" Text="Ningun reproductor activo"
                           FontSize="11.5" Margin="0,2,0,0"
                           Foreground="{StaticResource TextSecondary}"
                           TextTrimming="CharacterEllipsis" MaxWidth="230"
                           HorizontalAlignment="Left" />

                <ProgressBar x:Name="TrackProgress" Style="{StaticResource ThinBar}"
                             Margin="0,9,0,0" Value="0" Maximum="100" />

                <StackPanel Orientation="Horizontal" Margin="-6,4,0,0">
                  <Button x:Name="PrevButton" Style="{StaticResource IconButton}"
                          Content="&#xE100;" Click="PrevButton_Click" ToolTip="Anterior" />
                  <Button x:Name="PlayButton" Style="{StaticResource PlayButton}"
                          Content="&#xE768;" Click="PlayButton_Click" ToolTip="Reproducir / pausar" />
                  <Button x:Name="NextButton" Style="{StaticResource IconButton}"
                          Content="&#xE101;" Click="NextButton_Click" ToolTip="Siguiente" />
                </StackPanel>
              </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                        HorizontalAlignment="Right" Margin="8,0,0,0">
              <TextBlock x:Name="ClockText" Text="--:--"
                         FontSize="32" FontWeight="Light"
                         HorizontalAlignment="Right" />
              <TextBlock x:Name="DateText" Text=""
                         FontSize="11" Margin="0,-2,2,0"
                         Foreground="{StaticResource TextSecondary}"
                         HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>

          <!-- ======================================== separador -->
          <Border Grid.Row="1" Height="1" Margin="0,14,0,0" Background="#14FFFFFF" />

          <!-- ======================================== metricas -->
          <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="CPU" FontSize="9.5" Foreground="{StaticResource TextMuted}"
                         FontWeight="SemiBold" />
              <TextBlock x:Name="CpuValue" Text="--" FontSize="15" FontWeight="SemiBold"
                         Margin="0,1,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1">
              <TextBlock Text="RAM" FontSize="9.5" Foreground="{StaticResource TextMuted}"
                         FontWeight="SemiBold" />
              <TextBlock x:Name="RamValue" Text="--" FontSize="15" FontWeight="SemiBold"
                         Margin="0,1,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="RECORDATORIO" FontSize="9.5"
                           Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" />
                <Button x:Name="AddReminderButton" Style="{StaticResource IconButton}"
                        Content="&#xE710;" Width="16" Height="16" FontSize="8"
                        Margin="4,-3,0,0" ToolTip="Añadir recordatorio (Ctrl+Alt+R)"
                        Click="AddReminderButton_Click" />
              </StackPanel>
              <Button x:Name="ReminderButton" Style="{StaticResource ReminderButton}"
                      Click="ReminderButton_Click" ToolTip="Clic para marcarlo como hecho">
                <TextBlock x:Name="ReminderValue" Text="ninguno"
                           FontSize="15" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
              </Button>
            </StackPanel>
          </Grid>

          <!-- ======================================== estante -->
          <StackPanel x:Name="ShelfPanel" Grid.Row="3" Margin="0,13,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="ESTANTE" FontSize="9.5"
                         Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" />
              <TextBlock x:Name="ShelfHint" Text="arrastra archivos aquí"
                         FontSize="9.5" Margin="6,0,0,0"
                         Foreground="{StaticResource TextMuted}" />
            </StackPanel>
            <WrapPanel x:Name="ShelfBar" Margin="0,6,0,0" />
          </StackPanel>

          <!-- ======================================== lanzador -->
          <WrapPanel x:Name="LauncherBar" Grid.Row="4" Margin="0,13,0,0" />

          <!-- ======================================== entrada de recordatorio -->
          <Grid x:Name="ReminderInputRow" Grid.Row="5" Margin="0,11,0,0"
                Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ReminderInput" Grid.Column="0"
                     Style="{StaticResource IslaInput}"
                     KeyDown="ReminderInput_KeyDown" />
            <Button x:Name="ReminderSaveButton" Grid.Column="1" Margin="8,0,0,0"
                    Style="{StaticResource Chip}" Content="Guardar"
                    Click="ReminderSaveButton_Click" />
          </Grid>

        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
